generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  user
  manager
  admin
}

enum Status{
  active
  inactive
  deleted
}

enum Provider{
  whatsapp
  local
  google
  microsoft
}

enum TaskStaus{
  notSend
  pending
  inProgress
  hold
  remark
  deleted
}

enum TaskFinalStatus{
  blocked
  completed
  cancelled
}

enum DelayType{
  none
  notStartedOnTime
  exceededExpectedTime
}

enum AcceptStatus{
  accept
  remaining
  decline 
}

enum onTrackStatus{
  onTrack
  remark
  remaining
  absent
}

enum AttendenceType{
  morning
  afternoon
}

enum Setting{
  onTrackmsg
}

model User{
  id               String    @id @default(cuid())
  name             String   
  username         String    @unique @default(cuid())
  number           String  
  role             Role      @default(user)
  email            String?   @unique
  emailVerified    Boolean   @default(false)
  isWelcomemsgSend Boolean   @default(false)
  password         String?
  notAttentReason  String?  
  provider         Provider  @default(whatsapp) 

 //relations
  parentId         String?
  parent           User?     @relation("UserHierarchy",fields:[parentId],references:[id])
  children         User[]    @relation("UserHierarchy")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? 

  // revres connection
  Dailytask        DailyTask[]
  tasks            Task[]
  cron             Cron[]
  attendence       Attendence[]
  conversation     WhatsAppConversation[]
  adminSetting     AdminSettings[]
  createdsites     Site[]    @relation("Createdsites")
  sitelocations    UserSite[]

  @@index([parentId])
}

model DailyTask{
  id              String        @id @default(cuid())
  userId          String        

  status          AcceptStatus?
  finaldecision   onTrackStatus?          
  remarkReason    String?
  absentReason    String?

  sent            Boolean       @default(false)
  sendAt          DateTime?

  date            DateTime

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     

  user            User          @relation(fields:[userId] , references:[id] , onDelete:Cascade)

  tasks           Task[]
  @@index([userId])
  @@index([deletedAt])
}

model Task {
  id               String           @id @default(cuid())
  name             String
  dailyTaskId      String
  userId           String
  description      String?

  position         Int

  status           TaskStaus        @default(notSend)
  finaldecision    TaskFinalStatus?
  delayType        DelayType        @default(none)
  // remark reason
  remarkReason     String?
  howmuchComplete  String?
  
  // task time to complete
  actualTime       String?
  extratTme        Int?
  totalTime        String?

  //assign details
  sent             Boolean          @default(false)
  sendAt           DateTime?

  rawStartTime     String
  rawEndTime       String
  startAt          DateTime
  endAt            DateTime
  lasthold         DateTime?

  //normal details for dashbboard
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  updateById       String?

  deletedAt        DateTime?      

  //relation
  user             User             @relation(fields:[userId] , references:[id] , onDelete:Cascade)
  dailyTask        DailyTask        @relation(fields:[dailyTaskId] , references:[id] , onDelete:Cascade)

  @@index([userId])
  @@index([dailyTaskId])
  @@index([deletedAt])
}

model Attendence {
  id        String         @id @default(cuid())
  type      AttendenceType 
  time      String
  userId    String

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  user      User           @relation(fields:[userId],references:[id],onDelete:Cascade)

  @@index([userId])
  @@index([deletedAt])
}

model Cron {
  id         String   @id @default(cuid())
  name       String
  time       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  updateById String

  user       User     @relation(fields:[updateById],references:[id])

  @@index([name])
}

model WhatsAppConversation {
  id              String   @id @default(cuid())
  userId          String   @unique
  number          String   
 
  lastIncomingAt  DateTime?
  lastOutgoingAt  DateTime?
  windowExpiresAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields:[userId], references:[id], onDelete:Cascade)

  @@index([userId])
}

model AdminSettings {
  id        String   @id @default(cuid())
  adminId   String   

  name      Setting   
  isEnable  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin     User     @relation(fields:[adminId], references:[id] , onDelete:Cascade)
  
  @@index([adminId])
}

model Site {
  id        String    @id @default(cuid())
  name      String
  address   String
  latitude  Float
  longitude Float

  radius    Int       @default(200)
  status    Status    @default(active)

  addedbyId String
  addedby   User      @relation("Createdsites" , fields:[addedbyId] ,references:[id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users     UserSite[]
}

model UserSite {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
 
  createdAt DateTime @default(now())

  user      User     @relation(fields:[userId] ,references:[id])
  site      Site     @relation(fields:[siteId] , references:[id])

  @@unique([userId,siteId])
}